{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous.finance/pmvs/schemas/position-gnosis-ctf-1.schema.json",
  "title": "PMVS Gnosis CTF position profile v1",
  "type": "object",
  "required": [
    "profile",
    "chainId",
    "positionContract",
    "custodyAccount",
    "collateralToken",
    "oracle",
    "questionId",
    "outcomeSlotCount",
    "conditionId",
    "parentCollectionId",
    "indexSet",
    "collectionId",
    "positionId",
    "quantity"
  ],
  "properties": {
    "profile": { "const": "position/gnosis-ctf/1" },
    "chainId": { "$ref": "#/$defs/uint" },
    "positionContract": { "$ref": "#/$defs/nonzeroAddress" },
    "custodyAccount": { "$ref": "#/$defs/nonzeroAddress" },
    "collateralToken": { "$ref": "#/$defs/nonzeroAddress" },
    "oracle": { "$ref": "#/$defs/nonzeroAddress" },
    "questionId": { "$ref": "#/$defs/bytes32" },
    "outcomeSlotCount": {
      "type": "string",
      "pattern": "^(?:[2-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-6])$"
    },
    "conditionId": { "$ref": "#/$defs/bytes32" },
    "parentCollectionId": { "$ref": "#/$defs/bytes32" },
    "indexSet": { "$ref": "#/$defs/positiveUint" },
    "collectionId": { "$ref": "#/$defs/bytes32" },
    "positionId": { "$ref": "#/$defs/uint" },
    "quantity": { "$ref": "#/$defs/positiveUint" }
  },
  "additionalProperties": false,
  "$defs": {
    "uint": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
    "positiveUint": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "nonzeroAddress": { "type": "string", "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
